---
import { Icon } from 'astro-icon/components'
import Card from '@/components/ui/ServiceCard.astro'
import { getCollection } from 'astro:content'
import ServiceCard from '@/components/ui/ServiceCard.astro'

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order,
)
---

<section id="servicios" class="w-full bg-surface-lowest py-24">
  <div class="w-full max-w-[1440px] mx-auto px-5 md:px-8 lg:px-16 py-16 flex flex-col gap-8">
    <div class="flex flex-col gap-4 text-left" data-reveal>
      <div class="flex items-center gap-3">
        <span class="font-body text-xs font-medium leading-[16px] tracking-[0.08em] uppercase text-primary before:content-[''] before:w-6 before:h-px before:bg-current before:mr-3">
          Comisiones &amp; Colaboraciones
        </span>
      </div>
      <h2 class="font-display text-[48px] font-normal leading-[56px] tracking-[-0.015em] text-ink text-center">
        Servicios &amp; Comisiones Exclusivas
      </h2>
      <p class="font-body text-[15px] font-light leading-[24px] text-on-surface-variant max-w-3xl mx-auto text-center mt-4">
        Piezas por encargo personalizadas para coleccionistas privados, amantes
        del arte clásico y espacios arquitectónicos de autor.
      </p>
    </div>
    <div class="grid grid-cols-1 grid-cols-[repeat(auto-fit,minmax(280px,1fr))] md:px-10 gap-6 w-full">
      {services.map((service) => (
        <ServiceCard entry={service} />
      ))}
    </div>
  </div>
</section>
