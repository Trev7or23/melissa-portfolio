---
import { Icon } from 'astro-icon/components'
---

<section id="contacto" class="w-full bg-surface-lowest py-24">
  <div class="w-full max-w-[1440px] mx-auto px-5 md:px-8 lg:px-16 py-16 flex flex-col gap-8">
    <div class="flex flex-col gap-4 text-left" data-reveal>
      <div class="flex items-center gap-3">
        <span class="font-body text-xs font-medium leading-[16px] tracking-[0.08em] uppercase text-primary before:content-[''] before:w-6 before:h-px before:bg-current before:mr-3">
          Adquisiciones &amp; Encargos
        </span>
      </div>
      <h2 class="font-display text-[48px] font-normal leading-[56px] tracking-[-0.015em] text-ink">
        Iniciemos una Conversación
      </h2>
      <p class="font-body text-[15px] font-light leading-[24px] text-on-surface-variant max-w-44rem">
        Para encargos de retrato, solicitudes de catálogo privado o consulta de
        disponibilidad para nuevos proyectos.
      </p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <div class="lg:col-span-5 flex flex-col gap-4" data-reveal>
        <div class="bg-linear-to-br from-surface to-surface-high p-6 rounded relative overflow-hidden">
          <div class="absolute -right-8 -bottom-8 w-32 h-32 rounded-full blur-2xl bg-accent/10"></div>
          <div class="flex items-center gap-3">
            <Icon
              name="mdi:lightning-bolt"
              class="text-[18px] leading-[18px] text-primary"
            />
            <span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-primary">
              Respuesta Inmediata
            </span>
          </div>
          <h3 class="font-display text-[24px] font-normal leading-[32px] text-ink mt-3">
            Canal Directo de WhatsApp
          </h3>
          <p class="font-body text-[13px] font-normal leading-[20px] text-on-surface-variant mt-2">
            Atención personalizada directa por Melissa Gutiérrez para evaluar
            imágenes preliminares de referencia y brindar estimación de plazos.
          </p>
          <a
            href="https://wa.me/"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex items-center justify-center gap-2 w-full py-3.5 bg-primary-container text-on-primary-container font-body text-xs font-medium tracking-[0.08em] uppercase rounded transition-all"
          >
            <Icon name="mdi:message" class="text-[20px] leading-[20px]" />
            <span>Conversar directamente en WhatsApp</span>
          </a>
        </div>
        <div class="bg-surface-low p-5 rounded flex flex-col gap-4">
          <div class="flex items-start gap-3">
            <Icon
              name="mdi:calendar-check"
              class="text-2xl leading-[20px] text-primary mt-1"
            />
            <div>
              <span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-outline">
                Disponibilidad
              </span>
              <p class="font-body text-[13px] font-normal leading-[20px] text-on-surface m-0">
                Agenda abierta para comisiones privadas
              </p>
              <p class="font-body text-[12px] leading-[16px] text-on-surface-variant m-0">
                Pieza única, entrega nacional e internacional
              </p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <Icon
              name="mdi:email"
              class="text-2xl leading-[20px] text-primary mt-1"
            />
            <div>
              <span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-outline">
                Correo Electrónico Curatorial
              </span>
              <a
                href="mailto:contacto@melissagutierrez.art"
                class="font-body text-[13px] font-normal leading-[20px] text-on-surface transition-colors hover:text-primary"
              >
                contacto@melissagutierrez.art
              </a>
            </div>
          </div>
        </div>
      </div>
      <div
        class="lg:col-span-7 bg-surface-low p-6 rounded shadow-[0_24px_48px_-12px_rgba(0,0,0,0.75)]"
        data-reveal
      >
        <form
          class="flex flex-col gap-4"
          onsubmit="event.preventDefault(); document.getElementById('form-success').classList.remove('hidden');"
        >
          <div class="flex flex-col gap-2">
            <label
              class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-on-surface-variant"
              for="email"
            >
              Correo Electrónico *
            </label>
            <input
              class="w-full bg-surface px-4 py-3 rounded text-[13px] leading-[20px] text-on-surface border border-hairline font-body"
              id="email"
              placeholder="carlos@ejemplo.com"
              type="email"
              required
            />
          </div>
          <div class="flex flex-col gap-2">
            <label
              class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-on-surface-variant"
              for="message"
            >
              Descripción del Retrato o Mensaje *
            </label>
            <textarea
              class="w-full bg-surface px-4 py-3 rounded text-[13px] leading-[20px] text-on-surface border border-hairline font-body"
              id="message"
              placeholder="Cuéntame sobre la persona a retratar, la fecha deseada y si cuentas con fotografías nítidas para evaluar..."
              rows="6"
              required
            ></textarea>
          </div>
          <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-2">
            <p class="font-body text-[12px] leading-[16px] text-outline text-left">
              * Respondo todas las solicitudes en un plazo máximo de 24 a 48
              horas hábiles.
            </p>
            <button
              type="submit"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 w-full sm:w-auto bg-primary-container text-on-primary-container font-body text-xs font-medium tracking-[0.08em] uppercase rounded transition-all"
            >
              <Icon name="mdi:send" class="text-2xl leading-[18px]" />
              <span>Enviar Mensaje</span>
            </button>
          </div>
          <div
            class="hidden p-4 bg-surface-high rounded border-l-2 border-primary flex items-center gap-3"
            id="form-success"
          >
            <Icon
              name="mdi:check-circle-outline"
              class="text-2xl leading-[18px] text-primary"
            />
            <p class="font-body text-[13px] font-normal leading-[20px] text-on-surface">
              Mensaje recibido. Melissa Gutiérrez revisará tu solicitud y se
              pondrá en contacto a la brevedad.
            </p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
