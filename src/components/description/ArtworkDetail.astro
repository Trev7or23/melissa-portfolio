---
export interface Artwork {
	title: string;
	slug: string;
	year?: number;
	series?: string;
	kind?: string;
	technique?: string;
	support?: string;
	dimensions?: string;
	availability?: string;
	description?: string;
	curatorialStatement?: string;
	image?: string;
	order?: number;
}

interface Props {
	artwork: Artwork;
}

const { artwork } = Astro.props;
const year = artwork.year ?? 2024;
---

<section class="w-full bg-bg py-24">
	<div class="w-full max-w-[1440px] mx-auto px-5 md:px-8 lg:px-16 py-16 flex flex-col gap-8">
		<div class="w-full bg-surface-lowest/60 backdrop-blur-md">
			<div class="w-full max-w-[1440px] mx-auto px-5 md:px-8 lg:px-16 py-3 flex items-center justify-between">
				<a href="/#galeria" class="group inline-flex items-center gap-2 text-on-surface-variant transition-colors hover:text-on-surface">
					<span class="material-symbols-outlined text-[18px] leading-[18px] transition-transform duration-300 group-hover:-translate-x-1">west</span>
					<span class="font-body text-xs font-medium leading-[16px] tracking-[0.08em] uppercase">Volver a la galería</span>
				</a>
				<div class="hidden sm:flex items-center gap-4">
					<span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-outline">Catálogo {year} / Serie ‘{artwork.series}’</span>
					<span class="w-1.5 h-1.5 rounded-full bg-accent/60"></span>
					<span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-primary">Pieza I</span>
				</div>
			</div>
		</div>
		<div class="w-full max-w-[1440px] mx-auto px-5 md:px-8 lg:px-16 py-10 flex flex-col gap-8">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
				<div class="lg:col-span-7 flex flex-col gap-4">
					<div class="relative group bg-surface-lowest p-4 sm:p-7 rounded-xl overflow-hidden transition-all duration-700">
						<div class="absolute inset-0 bg-linear-to-t from-primary/10 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>
						<div class="relative bg-surface-low p-3 sm:p-5 rounded-lg shadow-inner">
							<div class="relative overflow-hidden rounded bg-surface flex items-center justify-center max-h-[820px]">
								{
									artwork.image ? (
										<img
											alt={"Obra " + artwork.title + " - Retrato hiperrealista en blanco y negro por Melissa Gutiérrez"}
											src={artwork.image}
											class="w-full h-auto object-cover max-h-[820px] shadow-[0_24px_48px_-12px_rgba(0,0,0,0.75)] transition-all duration-700"
										/>
									) : null
								}
							</div>
						</div>
						<div class="mt-3 px-1 flex items-center justify-between text-left">
							<span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-outline">Barbas de papel rasgado al agua · 300 g/m²</span>
							<span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-outline/60">Firmado &amp; Sellado al dorso</span>
						</div>
					</div>
					<div class="flex flex-col gap-2 pt-2">
						<span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-outline">Vistas en macro · Estudio microscópico del trazo</span>
						<div class="grid grid-cols-3 gap-3">
							<div class="group/thumb relative aspect-square bg-surface-lowest rounded-lg p-1.5 shadow-[0_12px_24px_-8px_rgba(0,0,0,0.75)] cursor-pointer">
								<div class="w-full h-full rounded overflow-hidden relative">
									<div class="w-full h-full bg-surface"></div>
									<div class="absolute bottom-1 left-1.5 right-1.5 px-1 py-0.5 bg-surface-lowest/90 backdrop-blur-sm rounded font-body text-[10px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-on-surface truncate">01. Trazo corneal &amp; luz</div>
								</div>
							</div>
							<div class="group/thumb relative aspect-square bg-surface-lowest rounded-lg p-1.5 shadow-[0_12px_24px_-8px_rgba(0,0,0,0.75)] cursor-pointer">
								<div class="w-full h-full rounded overflow-hidden relative">
									<div class="w-full h-full bg-surface"></div>
									<div class="absolute bottom-1 left-1.5 right-1.5 px-1 py-0.5 bg-surface-lowest/90 backdrop-blur-sm rounded font-body text-[10px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-on-surface truncate">02. Dermis y carbón 9B</div>
								</div>
							</div>
							<div class="group/thumb relative aspect-square bg-surface-lowest rounded-lg p-1.5 shadow-[0_12px_24px_-8px_rgba(0,0,0,0.75)] cursor-pointer">
								<div class="w-full h-full rounded overflow-hidden relative">
									<div class="w-full h-full bg-surface"></div>
									<div class="absolute bottom-1 left-1.5 right-1.5 px-1 py-0.5 bg-surface-lowest/90 backdrop-blur-sm rounded font-body text-[10px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-on-surface truncate">03. Claroscuro superior</div>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="lg:col-span-5 flex flex-col gap-6 lg:sticky lg:top-24">
					<div class="flex flex-col gap-4">
						<div class="flex items-center gap-3">
							<span class="material-symbols-outlined text-[16px] leading-[16px] text-primary">draw</span>
							<span class="font-body text-xs font-medium leading-[16px] tracking-[0.08em] uppercase text-primary">Retrato Contemporáneo en Grafito &amp; Carbón</span>
						</div>
						<h1 class="font-display text-[48px] font-normal leading-[56px] tracking-[-0.015em] text-ink">{artwork.title}</h1>
						<p class="font-body text-[15px] font-normal leading-[24px] italic text-on-surface-variant m-0">{year} · Serie “{artwork.series}”, Pieza I (Obra Testimonial)</p>
					</div>
					<div class="bg-surface-low rounded-xl p-5 shadow-[0_12px_24px_-8px_rgba(0,0,0,0.75)] flex flex-col gap-3">
						<span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-outline">Ficha Técnica de Conservación</span>
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div class="flex flex-col">
								<span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-outline-variant">Técnica</span>
								<span class="font-body text-[13px] font-medium leading-[20px] text-on-surface">{artwork.technique}</span>
							</div>
							<div class="flex flex-col">
								<span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-outline-variant">Soporte</span>
								<span class="font-body text-[13px] font-medium leading-[20px] text-on-surface">{artwork.support}</span>
							</div>
							<div class="flex flex-col">
								<span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-outline-variant">Dimensiones Hoja</span>
								<span class="font-body text-[13px] font-medium leading-[20px] text-on-surface">{artwork.dimensions}</span>
							</div>
							<div class="flex flex-col">
								<span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-outline-variant">Montaje en Vitrina</span>
								<span class="font-body text-[13px] font-medium leading-[20px] text-on-surface">1050 × 1380 mm · Vidrio Museal UV 99% antirreflejo</span>
							</div>
							<div class="flex flex-col">
								<span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-outline-variant">Tiempo de Ejecución</span>
								<span class="font-body text-[13px] font-medium leading-[20px] text-on-surface">96 horas de intervención directa sobre la obra</span>
							</div>
							<div class="flex flex-col">
								<span class="font-body text-[11px] font-semibold leading-[14px] tracking-[0.12em] uppercase text-outline-variant">Disponibilidad</span>
								<span class="font-body text-[13px] font-medium leading-[20px] text-primary flex items-center gap-1">{artwork.availability}</span>
							</div>
						</div>
					</div>
					<div class="flex flex-col gap-4">
						<h2 class="font-display text-[24px] font-normal leading-[32px] text-ink m-0">Memoria Curatorial &amp; Diálogo Emocional</h2>
						<div class="flex flex-col gap-3 font-body text-[15px] font-light leading-[24px] text-on-surface-variant">
							<p class="font-display text-[19px] font-normal italic leading-[28px] text-ink m-0">“{artwork.title}” {artwork.curatorialStatement}</p>
						</div>
					</div>
					<div class="bg-surface-high/80 rounded-xl p-5 shadow-[0_24px_48px_-12px_rgba(0,0,0,0.75)] flex flex-col gap-4 relative overflow-hidden">
						<div class="absolute -right-12 -bottom-12 w-36 h-36 rounded-full blur-2xl bg-accent/10 pointer-events-none"></div>
						<div class="flex items-start gap-3">
							<div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 bg-primary-container text-on-primary-container"><span class="material-symbols-outlined text-[22px] leading-[22px]">history_edu</span></div>
							<div class="flex flex-col">
								<span class="font-display text-[24px] font-normal leading-[32px] text-ink">¿Deseas encargar una obra similar?</span>
								<p class="font-body text-[13px] font-normal leading-[20px] text-on-surface-variant mt-1">Melissa acepta un cupo rigurosamente limitado de encargos privados al año en grafito y carbón sobre papel de algodón de conservación.</p>
							</div>
						</div>
						<div class="flex flex-col sm:flex-row gap-3 pt-2">
							<a href="https://wa.me/" target="_blank" rel="noopener noreferrer" class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-3 bg-primary-container text-on-primary-container font-body text-xs font-medium tracking-[0.08em] uppercase rounded transition-all">
								<span class="material-symbols-outlined text-[18px] leading-[18px]">chat</span>
								<span>Consultar por WhatsApp</span>
							</a>
							<a href="/#contacto" class="inline-flex items-center justify-center gap-2 px-4 py-3 bg-surface-lowest text-on-surface font-body text-xs font-medium tracking-[0.08em] uppercase rounded transition-all">Consultar Disponibilidad</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
